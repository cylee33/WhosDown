{
  "name": "whosdown-firebase",
  "private": true,
  "type": "module",
  "description": "WhosDown security rules, rules tests, and emulator seed data",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-whosdown",
    "test": "firebase emulators:exec --project demo-whosdown --only firestore,storage,auth \"vitest run\"",
    "seed": "node seed/seed.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.2",
    "geofire-common": "6.0.0",
    "vitest": "5.1.0"
  }
}
