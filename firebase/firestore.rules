rules_version = '2';

// WhosDown security rules, v1 (Phase 0).
// Deny by default. Each feature adds its own write rules, with tests in tests/.
// See docs/architecture.md §2 "Security-rule rules of thumb".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A Guest is signed in anonymously (1.3) and may read but never write.
    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isPlayer() {
      return signedIn() && !isGuest();
    }

    function isOwner(uid) {
      return isPlayer() && request.auth.uid == uid;
    }

    // Every field of users/{uid}, always written together (1.2, 1.4, 1.22).
    function profileKeys() {
      return ['displayName', 'displayNameLowercase', 'photoURL', 'bio', 'homeArea', 'playStyles',
              'sportLevels', 'customSportName', 'createdAt', 'onboardedAt'];
    }

    function optionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validProfile(d) {
      return d.keys().hasOnly(profileKeys()) && d.keys().hasAll(profileKeys())
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
        && d.displayNameLowercase == d.displayName.lower()
        && optionalString(d.photoURL, 2048)
        && optionalString(d.bio, 300)
        && optionalString(d.homeArea, 60)
        && (d.customSportName == null || (d.customSportName is string && d.customSportName.size() >= 1 && d.customSportName.size() <= 30))
        && d.playStyles is list && d.playStyles.size() <= 3
        && d.sportLevels is map && d.sportLevels.size() <= 9
        && (d.onboardedAt == null || d.onboardedAt is timestamp);
    }

    match /users/{uid} {
      allow read: if signedIn();
      // W1 (1.2): a new Player creates only their own profile, not yet onboarded.
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.onboardedAt == null;
      // Onboarding and profile edits (1.4, 1.22). createdAt never changes; onboardedAt is set once, by the server clock.
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.onboardedAt == resource.data.onboardedAt
            || (resource.data.onboardedAt == null && request.resource.data.onboardedAt == request.time));

      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
      }
    }

    function validVenue(d) {
      return d.keys().hasOnly(['name', 'nameLowercase', 'address', 'location', 'geohash', 'isIndoor',
                               'surface', 'hasLights', 'sports', 'createdBy'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.nameLowercase == d.name.lower()
        && d.address is string && d.address.size() <= 200
        && d.location.keys().hasOnly(['latitude', 'longitude'])
        && d.location.latitude is number && d.location.latitude >= -90 && d.location.latitude <= 90
        && d.location.longitude is number && d.location.longitude >= -180 && d.location.longitude <= 180
        && d.geohash is string && d.geohash.size() >= 5 && d.geohash.size() <= 12
        && d.isIndoor is bool && d.hasLights is bool
        && d.surface in ['turf', 'grass', 'hardwood', 'court', 'sand', 'other']
        && d.sports is list;
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      // W18 (1.12): any Player (not a Guest) saves a new Venue as themselves; only its creator edits it; nobody deletes.
      allow create: if isPlayer() && request.resource.data.createdBy == request.auth.uid && validVenue(request.resource.data);
      allow update: if isPlayer() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy && validVenue(request.resource.data);
    }

    match /matches/{matchId} {
      allow read: if signedIn();

      match /rsvps/{uid} {
        allow read: if signedIn();
      }
    }

    // Collection-group queries over RSVPs (My Matches, Reliability).
    match /{path=**}/rsvps/{uid} {
      allow read: if signedIn();
    }
  }
}
