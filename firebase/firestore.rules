rules_version = '2';

// WhosDown security rules, v1 (Phase 0).
// Deny by default. Each feature adds its own write rules, with tests in tests/.
// See docs/architecture.md §2 "Security-rule rules of thumb".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A Guest is signed in anonymously (1.3) and may read but never write.
    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isPlayer() {
      return signedIn() && !isGuest();
    }

    function isOwner(uid) {
      return isPlayer() && request.auth.uid == uid;
    }

    // Every field of users/{uid}, always written together (1.2, 1.4, 1.22).
    function profileKeys() {
      return ['displayName', 'displayNameLowercase', 'photoURL', 'bio', 'homeArea', 'playStyles',
              'sportLevels', 'customSportName', 'createdAt', 'onboardedAt'];
    }

    function optionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validProfile(d) {
      return d.keys().hasOnly(profileKeys()) && d.keys().hasAll(profileKeys())
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
        && d.displayNameLowercase == d.displayName.lower()
        && optionalString(d.photoURL, 2048)
        && optionalString(d.bio, 300)
        && optionalString(d.homeArea, 60)
        && (d.customSportName == null || (d.customSportName is string && d.customSportName.size() >= 1 && d.customSportName.size() <= 30))
        && d.playStyles is list && d.playStyles.size() <= 3
        && d.sportLevels is map && d.sportLevels.size() <= 9
        && (d.onboardedAt == null || d.onboardedAt is timestamp);
    }

    match /users/{uid} {
      allow read: if signedIn();
      // W1 (1.2): a new Player creates only their own profile, not yet onboarded.
      allow create: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.onboardedAt == null;
      // Onboarding and profile edits (1.4, 1.22). createdAt never changes; onboardedAt is set once, by the server clock.
      allow update: if isOwner(uid) && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.onboardedAt == resource.data.onboardedAt
            || (resource.data.onboardedAt == null && request.resource.data.onboardedAt == request.time));

      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        // D38: a Player writes into another inbox only as themselves, and only with a role in that Match.
        allow create: if isPlayer() && validNotification(request.resource.data) && involvedIn(request.resource.data.matchId);
        allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isOwner(uid);
      }
    }

    function validNotification(d) {
      return d.keys().hasOnly(['type', 'title', 'body', 'matchId', 'fromUserId', 'changes', 'hostNote', 'isRead', 'createdAt'])
        && d.type in ['approved', 'declined', 'matchUpdated', 'matchCancelled', 'spotOpened', 'hostTransferred']
        && d.title is string && d.title.size() <= 140
        && d.body is string && d.body.size() <= 500
        && d.matchId is string
        && d.fromUserId == request.auth.uid
        && (d.changes == null || d.changes is list)
        && optionalString(d.hostNote, 300)
        && d.isRead == false
        && d.createdAt == request.time;
    }

    function involvedIn(matchId) {
      return matchId is string
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && (get(/databases/$(database)/documents/matches/$(matchId)).data.hostId == request.auth.uid
            || exists(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)));
    }

    function validVenue(d) {
      return d.keys().hasOnly(['name', 'nameLowercase', 'address', 'location', 'geohash', 'isIndoor',
                               'surface', 'hasLights', 'sports', 'createdBy'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.nameLowercase == d.name.lower()
        && d.address is string && d.address.size() <= 200
        && d.location.keys().hasOnly(['latitude', 'longitude'])
        && d.location.latitude is number && d.location.latitude >= -90 && d.location.latitude <= 90
        && d.location.longitude is number && d.location.longitude >= -180 && d.location.longitude <= 180
        && d.geohash is string && d.geohash.size() >= 5 && d.geohash.size() <= 12
        && d.isIndoor is bool && d.hasLights is bool
        && d.surface in ['turf', 'grass', 'hardwood', 'court', 'sand', 'other']
        && d.sports is list;
    }

    match /venues/{venueId} {
      allow read: if signedIn();
      // W18 (1.12): any Player (not a Guest) saves a new Venue as themselves; only its creator edits it; nobody deletes.
      allow create: if isPlayer() && request.resource.data.createdBy == request.auth.uid && validVenue(request.resource.data);
      allow update: if isPlayer() && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy && validVenue(request.resource.data);
    }

    function matchKeys() {
      return ['title', 'titleLowercase', 'sport', 'customSportName', 'notes', 'hostId', 'hostName', 'venueId',
              'venueName', 'location', 'geohash', 'isIndoor', 'surface', 'hasLights', 'startTime', 'endTime',
              'skillLevel', 'joinType', 'priceCents', 'playerLimit', 'waitlistEnabled', 'joinedCount',
              'pendingCount', 'waitlistCount', 'waitlistIds', 'attendeePreview', 'fieldReserved',
              'reservationWindow', 'facilityNote', 'status', 'cancelReason', 'checkedInAt', 'createdAt', 'updatedAt'];
    }

    // The fields a Host chooses (1.11, and later edits in 1.18).
    function validMatchDetails(d) {
      return d.keys().hasOnly(matchKeys()) && d.keys().hasAll(matchKeys())
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 40
        && d.titleLowercase == d.title.lower()
        && d.sport in ['soccer', 'basketball', 'tennis', 'volleyball', 'pickleball', 'baseball', 'football', 'ultimate', 'other']
        && (d.sport == 'other'
            ? (d.customSportName is string && d.customSportName.size() >= 1 && d.customSportName.size() <= 30)
            : d.customSportName == null)
        && optionalString(d.notes, 500)
        && d.hostName is string && d.venueName is string && d.venueId is string
        && d.location.latitude is number && d.location.longitude is number
        && d.geohash is string && d.geohash.size() >= 5
        && d.isIndoor is bool && d.hasLights is bool && d.surface is string
        && d.startTime is timestamp && d.endTime is timestamp
        && d.endTime > d.startTime && d.endTime <= d.startTime + duration.value(6, 'h')
        && d.skillLevel in ['beginner', 'casual', 'allLevels', 'intermediate', 'competitive']
        && d.joinType in ['open', 'approvalRequired']
        && d.priceCents is int && d.priceCents >= 0 && d.priceCents <= 10000
        && d.playerLimit is int && d.playerLimit >= 2 && d.playerLimit <= 50
        && d.waitlistEnabled is bool && d.fieldReserved is bool
        && optionalString(d.reservationWindow, 40)
        && optionalString(d.facilityNote, 200)
        && d.attendeePreview is list && d.attendeePreview.size() <= 6;
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      // W3 (1.11): a Player publishes a future Match as its Host, with the starting counters
      // (the Host counts as the first joined Player) and server timestamps.
      allow create: if isPlayer() && validMatchDetails(request.resource.data)
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.startTime > request.time
        && request.resource.data.status == 'scheduled'
        && request.resource.data.joinedCount == 1
        && request.resource.data.pendingCount == 0
        && request.resource.data.waitlistCount == 0
        && request.resource.data.waitlistIds == []
        && request.resource.data.cancelReason == null
        && request.resource.data.checkedInAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // The Host's own RSVP and the Match chat are written in the same batch.
        && existsAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/conversations/$(matchId));

      // Counter changes that travel with an RSVP write (1.13–1.16). Detail edits come in 1.18.
      allow update: if isPlayer() && request.resource.data.updatedAt == request.time && (
        (matchDetailsUnchanged() && (openJoinCounters(matchId) || requestCounters(matchId)
            || leaveApprovedCounters(matchId) || leavePendingCounters(matchId) || leaveWaitlistCounters(matchId)
            || hostApproveCounters(matchId) || hostDeclineCounters() || joinWaitlistCounters(matchId)
            || promoteCounters(matchId) || hostWaitlistApproveCounters(matchId)))
        || hostEdit() || hostCancel() || hostTransfer(matchId) || hostCheckInStamp()
      );

      match /rsvps/{uid} {
        allow read: if signedIn();
        // W3 (1.11): the Host's own approved RSVP, only while the Match itself is being created.
        allow create: if isOwner(uid) && (
          (!exists(/databases/$(database)/documents/matches/$(matchId))
            && getAfter(/databases/$(database)/documents/matches/$(matchId)).data.hostId == uid
            && request.resource.data.userId == uid
            && request.resource.data.status == 'approved'
            && request.resource.data.isHost == true
            && request.resource.data.checkedIn == false
            && request.resource.data.attended == null)
          || openJoinRSVP(matchId, uid)
          || requestRSVP(matchId, uid)
          || waitlistRSVP(matchId, uid)
        );
        allow update: if openJoinRSVP(matchId, uid) || requestRSVP(matchId, uid) || waitlistRSVP(matchId, uid)
          || leaveRSVP(matchId, uid) || hostDecisionRSVP(matchId, uid) || promotedRSVP(matchId, uid)
          || hostWaitlistDecision(matchId, uid) || checkInRSVP(matchId, uid) || transferFlag(matchId, uid);
      }
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function matchAfter(matchId) {
      return getAfter(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function matchIsOpen(matchId) {
      return matchData(matchId).status == 'scheduled' && matchData(matchId).startTime > request.time;
    }

    function matchDetailsUnchanged() {
      let b = resource.data;
      let a = request.resource.data;
      return a.title == b.title && a.titleLowercase == b.titleLowercase && a.sport == b.sport
        && a.customSportName == b.customSportName && a.notes == b.notes
        && a.hostId == b.hostId && a.hostName == b.hostName
        && a.venueId == b.venueId && a.venueName == b.venueName
        && a.location == b.location && a.geohash == b.geohash
        && a.isIndoor == b.isIndoor && a.surface == b.surface && a.hasLights == b.hasLights
        && a.startTime == b.startTime && a.endTime == b.endTime
        && a.skillLevel == b.skillLevel && a.joinType == b.joinType
        && a.priceCents == b.priceCents && a.playerLimit == b.playerLimit && a.waitlistEnabled == b.waitlistEnabled
        && a.fieldReserved == b.fieldReserved && a.reservationWindow == b.reservationWindow
        && a.facilityNote == b.facilityNote && a.status == b.status && a.cancelReason == b.cancelReason
        && a.checkedInAt == b.checkedInAt && a.createdAt == b.createdAt
        && a.attendeePreview is list && a.attendeePreview.size() <= 6;
    }

    function rsvpShape(d, uid) {
      return d.keys().hasOnly(['userId', 'displayName', 'skillLevel', 'status', 'isHost', 'noteToHost',
                               'hostResponse', 'requestedAt', 'respondedAt', 'checkedIn', 'attended'])
        && d.userId == uid
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
        && d.skillLevel in ['beginner', 'casual', 'allLevels', 'intermediate', 'competitive']
        && d.status in ['pending', 'approved', 'declined', 'waitlisted', 'left']
        && d.isHost == false
        && optionalString(d.noteToHost, 300)
        && optionalString(d.hostResponse, 300)
        && d.checkedIn == false
        && d.attended == null;
    }

    function wasLeftOrNew(matchId, uid) {
      return !exists(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(uid))
        || resource.data.status == 'left';
    }

    function openJoinRSVP(matchId, uid) {
      let d = request.resource.data;
      return isOwner(uid) && rsvpShape(d, uid) && d.status == 'approved'
        && d.requestedAt == request.time && d.respondedAt == request.time
        && wasLeftOrNew(matchId, uid)
        && matchData(matchId).joinType == 'open' && matchIsOpen(matchId)
        && matchData(matchId).hostId != uid
        && matchAfter(matchId).joinedCount == matchData(matchId).joinedCount + 1
        && matchAfter(matchId).joinedCount <= matchAfter(matchId).playerLimit
        && matchAfter(matchId).pendingCount == matchData(matchId).pendingCount;
    }

    function requestRSVP(matchId, uid) {
      let d = request.resource.data;
      return isOwner(uid) && rsvpShape(d, uid) && d.status == 'pending'
        && d.requestedAt == request.time && d.respondedAt == null
        && wasLeftOrNew(matchId, uid)
        && matchData(matchId).joinType == 'approvalRequired' && matchIsOpen(matchId)
        && matchData(matchId).hostId != uid
        && matchData(matchId).joinedCount < matchData(matchId).playerLimit
        && matchAfter(matchId).pendingCount == matchData(matchId).pendingCount + 1
        && matchAfter(matchId).joinedCount == matchData(matchId).joinedCount;
    }

    function leaveRSVP(matchId, uid) {
      return isOwner(uid) && resource.data.isHost == false
        && resource.data.status in ['approved', 'pending', 'waitlisted']
        && request.resource.data.status == 'left'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && matchIsOpen(matchId) && matchData(matchId).hostId != uid;
    }

    function hostDecisionRSVP(matchId, uid) {
      return isPlayer() && uid != request.auth.uid
        && matchData(matchId).hostId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.respondedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'hostResponse'])
        && (
          (request.resource.data.status == 'approved'
            && matchAfter(matchId).joinedCount == matchData(matchId).joinedCount + 1
            && matchAfter(matchId).joinedCount <= matchData(matchId).playerLimit
            && matchAfter(matchId).pendingCount == matchData(matchId).pendingCount - 1
            && matchIsOpen(matchId))
          || (request.resource.data.status == 'declined'
            && matchAfter(matchId).joinedCount == matchData(matchId).joinedCount
            && matchAfter(matchId).pendingCount == matchData(matchId).pendingCount - 1)
        );
    }

    function openJoinCounters(matchId) {
      return resource.data.joinType == 'open' && matchIsOpen(matchId) && resource.data.hostId != request.auth.uid
        && request.resource.data.joinedCount == resource.data.joinedCount + 1
        && request.resource.data.joinedCount <= request.resource.data.playerLimit
        && request.resource.data.pendingCount == resource.data.pendingCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'approved';
    }

    function requestCounters(matchId) {
      return resource.data.joinType == 'approvalRequired' && matchIsOpen(matchId)
        && resource.data.hostId != request.auth.uid
        && request.resource.data.pendingCount == resource.data.pendingCount + 1
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds
        && request.resource.data.attendeePreview == resource.data.attendeePreview
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'pending';
    }

    function leaveApprovedCounters(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'left'
        && request.resource.data.joinedCount == resource.data.joinedCount - 1
        && request.resource.data.pendingCount == resource.data.pendingCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds;
    }

    function leavePendingCounters(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'left'
        && request.resource.data.pendingCount == resource.data.pendingCount - 1
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds
        && request.resource.data.attendeePreview == resource.data.attendeePreview;
    }

    function leaveWaitlistCounters(matchId) {
      return request.resource.data.waitlistCount == resource.data.waitlistCount - 1
        && request.resource.data.waitlistIds == resource.data.waitlistIds.removeAll([request.auth.uid])
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.pendingCount == resource.data.pendingCount
        && request.resource.data.attendeePreview == resource.data.attendeePreview
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'left';
    }

    function hostApproveCounters(matchId) {
      return resource.data.hostId == request.auth.uid && matchIsOpen(matchId)
        && request.resource.data.joinedCount == resource.data.joinedCount + 1
        && request.resource.data.joinedCount <= resource.data.playerLimit
        && request.resource.data.pendingCount == resource.data.pendingCount - 1
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds;
    }

    function joinWaitlistCounters(matchId) {
      return resource.data.waitlistEnabled == true && resource.data.joinedCount >= resource.data.playerLimit
        && matchIsOpen(matchId) && resource.data.hostId != request.auth.uid
        && resource.data.waitlistIds.size() < 50
        && request.resource.data.waitlistIds == resource.data.waitlistIds.concat([request.auth.uid])
        && request.resource.data.waitlistCount == resource.data.waitlistCount + 1
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.pendingCount == resource.data.pendingCount
        && request.resource.data.attendeePreview == resource.data.attendeePreview
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'waitlisted';
    }

    function promoteCounters(matchId) {
      return resource.data.joinType == 'open' && resource.data.waitlistIds.size() > 0
        && get(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'left'
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount - 1
        && request.resource.data.waitlistIds == resource.data.waitlistIds.removeAll([resource.data.waitlistIds[0]])
        && request.resource.data.pendingCount == resource.data.pendingCount
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(resource.data.waitlistIds[0])).data.status == 'approved';
    }

    function hostWaitlistApproveCounters(matchId) {
      return resource.data.hostId == request.auth.uid
        && resource.data.joinedCount < resource.data.playerLimit
        && request.resource.data.joinedCount == resource.data.joinedCount + 1
        && request.resource.data.waitlistCount == resource.data.waitlistCount - 1
        && request.resource.data.pendingCount == resource.data.pendingCount;
    }

    function hostEdit() {
      return resource.data.hostId == request.auth.uid && resource.data.status == 'scheduled'
        && resource.data.startTime > request.time
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.hostName == resource.data.hostName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.pendingCount == resource.data.pendingCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds
        && request.resource.data.status == 'scheduled'
        && request.resource.data.cancelReason == resource.data.cancelReason
        && request.resource.data.checkedInAt == resource.data.checkedInAt
        && request.resource.data.playerLimit >= resource.data.joinedCount
        && validMatchDetails(request.resource.data);
    }

    function hostCancel() {
      return resource.data.hostId == request.auth.uid && resource.data.status == 'scheduled'
        && resource.data.startTime > request.time
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelReason is string
        && request.resource.data.cancelReason.size() >= 1
        && request.resource.data.cancelReason.size() <= 200
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.pendingCount == resource.data.pendingCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.title == resource.data.title
        && request.resource.data.startTime == resource.data.startTime;
    }

    function hostTransfer(matchId) {
      return resource.data.hostId == request.auth.uid
        && request.resource.data.hostId != resource.data.hostId
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.pendingCount == resource.data.pendingCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds
        && request.resource.data.status == resource.data.status
        && request.resource.data.playerLimit == resource.data.playerLimit
        && get(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.resource.data.hostId)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.isHost == false
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.resource.data.hostId)).data.isHost == true;
    }

    function hostCheckInStamp() {
      return resource.data.hostId == request.auth.uid && resource.data.status == 'scheduled'
        && resource.data.startTime <= request.time
        && request.time <= resource.data.endTime + duration.value(48, 'h')
        && request.resource.data.checkedInAt == request.time
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.status == resource.data.status
        && request.resource.data.title == resource.data.title;
    }

    function waitlistRSVP(matchId, uid) {
      let d = request.resource.data;
      return isOwner(uid) && rsvpShape(d, uid) && d.status == 'waitlisted'
        && d.requestedAt == request.time && d.respondedAt == null
        && wasLeftOrNew(matchId, uid)
        && matchIsOpen(matchId) && matchData(matchId).hostId != uid
        && matchData(matchId).waitlistEnabled == true
        && matchData(matchId).joinedCount >= matchData(matchId).playerLimit
        && matchAfter(matchId).waitlistCount == matchData(matchId).waitlistCount + 1;
    }

    function promotedRSVP(matchId, uid) {
      return uid != request.auth.uid
        && resource.data.status == 'waitlisted'
        && request.resource.data.status == 'approved'
        && request.resource.data.respondedAt == request.time
        && matchData(matchId).joinType == 'open'
        && matchData(matchId).waitlistIds[0] == uid
        && get(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/matches/$(matchId)/rsvps/$(request.auth.uid)).data.status == 'left';
    }

    function hostWaitlistDecision(matchId, uid) {
      return isPlayer() && uid != request.auth.uid
        && matchData(matchId).hostId == request.auth.uid
        && resource.data.status == 'waitlisted'
        && request.resource.data.status == 'approved'
        && request.resource.data.respondedAt == request.time
        && matchData(matchId).joinedCount < matchData(matchId).playerLimit
        && matchAfter(matchId).joinedCount == matchData(matchId).joinedCount + 1
        && matchAfter(matchId).waitlistCount == matchData(matchId).waitlistCount - 1;
    }

    function checkInRSVP(matchId, uid) {
      return matchData(matchId).hostId == request.auth.uid
        && resource.data.status == 'approved'
        && request.resource.data.checkedIn == true
        && request.resource.data.attended is bool
        && (uid != request.auth.uid || request.resource.data.attended == true)
        && matchData(matchId).status == 'scheduled'
        && matchData(matchId).startTime <= request.time
        && request.time <= matchData(matchId).endTime + duration.value(48, 'h');
    }

    function transferFlag(matchId, uid) {
      return matchData(matchId).hostId == request.auth.uid
        && matchAfter(matchId).hostId != request.auth.uid
        && (
          (uid == request.auth.uid && resource.data.isHost == true && request.resource.data.isHost == false)
          || (uid == matchAfter(matchId).hostId && resource.data.status == 'approved' && request.resource.data.isHost == true)
        );
    }

    function hostDeclineCounters() {
      return resource.data.hostId == request.auth.uid
        && request.resource.data.pendingCount == resource.data.pendingCount - 1
        && request.resource.data.joinedCount == resource.data.joinedCount
        && request.resource.data.waitlistCount == resource.data.waitlistCount
        && request.resource.data.waitlistIds == resource.data.waitlistIds
        && request.resource.data.attendeePreview == resource.data.attendeePreview;
    }

    // Match chat (D39). Read and post rules come with 1.20.
    match /conversations/{matchId} {
      // The Host and approved Players can read the preview (1.15) and the chat (1.20, D39).
      allow read: if canChat(matchId);
      allow update: if canChat(matchId)
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.matchId == resource.data.matchId
        && request.resource.data.lastMessageText is string
        && request.resource.data.lastMessageText.size() > 0
        && request.resource.data.lastMessageText.size() <= 1000
        && request.resource.data.lastMessageAt == request.time;

      match /messages/{messageId} {
        allow read: if canChat(matchId);
        allow create: if canChat(matchId)
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'sentAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sentAt == request.time;
      }

      // W3 (1.11): created by the Host together with a new Match.
      allow create: if isPlayer()
        && !exists(/databases/$(database)/documents/matches/$(matchId))
        && getAfter(/databases/$(database)/documents/matches/$(matchId)).data.hostId == request.auth.uid
        && request.resource.data.type == 'match'
        && request.resource.data.matchId == matchId;
    }

    function canChat(id) {
      return id is string && isPlayer()
        && exists(/databases/$(database)/documents/matches/$(id))
        && (get(/databases/$(database)/documents/matches/$(id)).data.hostId == request.auth.uid
            || (exists(/databases/$(database)/documents/matches/$(id)/rsvps/$(request.auth.uid))
                && get(/databases/$(database)/documents/matches/$(id)/rsvps/$(request.auth.uid)).data.status == 'approved'));
    }

    // Collection-group queries over RSVPs (My Matches, Reliability).
    match /{path=**}/rsvps/{uid} {
      allow read: if signedIn();
    }
  }
}
