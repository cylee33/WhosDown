rules_version = '2';

// WhosDown security rules, v1 (Phase 0).
// Deny by default. Each feature adds its own write rules, with tests in tests/.
// See docs/architecture.md §2 "Security-rule rules of thumb".
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A Guest is signed in anonymously (1.3) and may read but never write.
    function isGuest() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isPlayer() {
      return signedIn() && !isGuest();
    }

    function isOwner(uid) {
      return isPlayer() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn();

      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
      }
    }

    match /venues/{venueId} {
      allow read: if signedIn();
    }

    match /matches/{matchId} {
      allow read: if signedIn();

      match /rsvps/{uid} {
        allow read: if signedIn();
      }
    }

    // Collection-group queries over RSVPs (My Matches, Reliability).
    match /{path=**}/rsvps/{uid} {
      allow read: if signedIn();
    }
  }
}
